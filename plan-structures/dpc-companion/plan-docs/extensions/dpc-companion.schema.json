{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commoncare.dev/schemas/extensions/dpc-companion.schema.json",
  "title": "DPC Companion Document Extension",
  "description": "Document identity for the DPC coverage concept. Funding classifications follow the adopted underlying benefits and employee circumstances; no employer-wide funding pathway is established here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document"
  ],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "effectiveDate"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "effectiveDate": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
