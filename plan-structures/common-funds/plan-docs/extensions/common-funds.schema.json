{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commoncare.dev/schemas/extensions/common-funds.schema.json",
  "title": "CommonFunds Coordinated Benefit Extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "coordinatedCoverageType",
    "hra",
    "healthFsa"
  ],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "effectiveDate"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "appendixNumber": {
          "type": "string",
          "description": "Optional legacy appendix label. Not required for document generation.",
          "deprecated": true
        },
        "effectiveDate": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "groupCoverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isOffered": {
          "const": true
        },
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "isNonExcepted": {
          "const": true
        }
      },
      "readOnly": true
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "monthlyEmployerOnlyAmount": {
          "type": "number",
          "minimum": 0
        },
        "monthlyHealthOnlyFlexCredit": {
          "type": "number",
          "minimum": 0
        },
        "monthlyCashableFlexCredit": {
          "type": "number",
          "minimum": 0
        },
        "annualDirectEmployeeFsaElection": {
          "type": "number",
          "minimum": 0
        },
        "priorityRule": {
          "type": "string",
          "minLength": 1
        }
      },
      "readOnly": true
    },
    "deductible": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "appliesToHealthFsa": {
          "type": "boolean"
        },
        "appliesToHra": {
          "type": "boolean"
        },
        "accumulationRule": {
          "type": "string",
          "description": "Read-only accumulation basis from coverage.deductible.type; no independent document election."
        },
        "coverage": {
          "type": "object",
          "description": "Read-only snapshot of the coverage deductible settings."
        },
        "categories": {
          "type": "object",
          "description": "Read-only snapshot of category-specific coverage deductibles."
        },
        "preventive": {
          "type": "boolean",
          "readOnly": true,
          "description": "Coverage.preventive snapshot. Only preventive care expressly enabled on the coverage may be offered before an applicable deductible, subject to applicable law. Not a document-specific election."
        }
      }
    },
    "hra": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentEnabled"
      ],
      "properties": {
        "componentEnabled": {
          "type": "boolean",
          "description": "Whether the optional CommonFunds HRA component is offered. Its governing document and benefit terms are required only when enabled."
        },
        "componentType": {
          "enum": [
            "ebhra",
            "integrated-hra",
            "none"
          ]
        },
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "annualEmployerAmount": {
          "type": "number",
          "minimum": 0
        },
        "monthlyAccrual": {
          "type": "number",
          "minimum": 0
        },
        "advanceMonths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12,
          "default": 1
        },
        "recourseForUnaccruedAdvance": {
          "type": "boolean"
        },
        "eligibleExpenses": {
          "type": "string",
          "minLength": 1
        },
        "carryoverAllowed": {
          "type": "boolean",
          "default": false
        },
        "carryoverRule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "healthFsa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentEnabled"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "annualSalaryReduction": {
          "type": "number",
          "minimum": 0
        },
        "annualCashableFlexElected": {
          "type": "number",
          "minimum": 0
        },
        "annualTrueEmployerContribution": {
          "type": "number",
          "minimum": 0
        },
        "annualMaximumBenefit": {
          "type": "number",
          "minimum": 0
        },
        "uniformCoverage": {
          "const": true
        },
        "eligibleExpenses": {
          "type": "string",
          "minLength": 1
        },
        "carryoverAllowed": {
          "type": "boolean",
          "default": false
        },
        "gracePeriodAllowed": {
          "type": "boolean",
          "default": false
        },
        "unusedAmountRule": {
          "type": "string",
          "minLength": 1
        },
        "componentEnabled": {
          "type": "boolean",
          "description": "Whether the optional Health FSA component is offered. Its governing document and benefit terms are required only when enabled."
        },
        "salaryReductionLimitDescription": {
          "type": "string",
          "description": "Read-only description of the applicable annual IRS salary-reduction maximum, supplied from the application limits table. No Participant election amount."
        },
        "salaryReductionLimit": {
          "type": "number",
          "minimum": 0,
          "description": "Read-only annual IRS maximum from application limits, when the year is available."
        }
      }
    },
    "endingBalance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultRule": {
          "type": "string",
          "minLength": 1
        },
        "employerPropertySubjectToLaw": {
          "const": true
        },
        "rule": {
          "type": "string",
          "description": "Read-only narrative derived from the coverage disposition enum. Not a separate document election."
        },
        "disposition": {
          "type": "string",
          "enum": [
            "employer",
            "carryover",
            "employee"
          ],
          "readOnly": true,
          "description": "Coverage-defined year-end policy. Employer retention is the default. Employee distribution means legally distributable experience gains on a pro-rata uniform basis, never individual account balances."
        }
      },
      "readOnly": true
    },
    "coordinatedCoverageType": {
      "enum": [
        "none",
        "group-medical",
        "ichra"
      ],
      "description": "Type of coverage linked through coverage.settings.coordinatedCoverageId. Derived from coverage settings; independent of the CommonFunds HRA component type.",
      "readOnly": true
    }
  },
  "description": "CommonFunds document context. Coverage and Plan settings supply benefit terms; contribution methods and Participant elections remain in settings and enrollment. Document generation does not maintain an independent benefit configuration.",
  "allOf": [
    {
      "if": {
        "properties": {
          "coordinatedCoverageType": {
            "const": "ichra"
          }
        },
        "required": [
          "coordinatedCoverageType"
        ]
      },
      "then": {
        "properties": {
          "hra": {
            "properties": {
              "componentEnabled": {
                "const": false
              },
              "componentType": {
                "const": "none"
              }
            }
          }
        }
      }
    }
  ]
}
