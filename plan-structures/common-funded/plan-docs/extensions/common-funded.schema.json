{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commoncare.dev/schemas/extensions/common-funded.schema.json",
  "title": "CommonFunded Overlay Extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "majorMedicalCoverage", "commonFunds", "annexedCommonFundsDocuments", "allocationObjective", "bandingDescription"],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "effectiveDate"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "effectiveDate": { "type": "string", "format": "date" }
      }
    },
    "majorMedicalCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "documentId", "coverageType"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "documentId": { "type": "string", "minLength": 1 },
        "coverageType": { "type": "string", "enum": ["choice-ichra", "self-funded", "group-insurance-contract", "other"] }
      }
    },
    "commonFunds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "documentId"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "documentId": { "type": "string", "minLength": 1 }
      }
    },
    "annexedCommonFundsDocuments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "documentId"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "documentId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "allocationObjective": { "type": "string", "minLength": 1 },
    "bandingDescription": { "type": "string", "minLength": 1 }
  }
}
