{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commoncare.dev/schemas/extensions/self-funded-dental.schema.json",
  "title": "CommonCare Self-Funded Dental Extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document"
  ],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "effectiveDate"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "appendixNumber": {
          "type": "string",
          "description": "Optional legacy appendix label. Not required for document generation.",
          "deprecated": true
        },
        "effectiveDate": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "coverageTier": {
      "type": "string",
      "description": "Read-only coverage variant names."
    },
    "deductiblePerEvent": {
      "type": "number",
      "minimum": 0,
      "description": "Legacy single deductible value; use deductibleDescription for the complete adopted rule."
    },
    "planCoinsurance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "individualAnnualMaximum": {
      "type": "number",
      "minimum": 0
    },
    "familyAnnualMaximum": {
      "type": "number",
      "minimum": 0
    },
    "claimFilingDeadlineDays": {
      "type": "integer",
      "minimum": 1,
      "default": 180
    },
    "deductibleDescription": {
      "type": "string",
      "description": "Read-only deductible terms."
    },
    "coverageSummary": {
      "type": "string",
      "description": "Read-only schedule-style summary of the selected coverage. Missing descriptive terms refer to the incorporated coverage terms."
    }
  }
}
