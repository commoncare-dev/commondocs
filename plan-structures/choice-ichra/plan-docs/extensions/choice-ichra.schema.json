{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commoncare.dev/schemas/extensions/choice-ichra.schema.json",
  "title": "CommonCare CHOICE ICHRA Extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "eligibleClass",
    "monthlyEmployerContribution",
    "contributionVariation",
    "permittedExpenses",
    "claimsRunoutDays"
  ],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "effectiveDate"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "appendixNumber": {
          "type": "string",
          "description": "Optional legacy appendix label. Not required for document generation.",
          "deprecated": true
        },
        "effectiveDate": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "eligibleClass": {
      "type": "string",
      "minLength": 1
    },
    "monthlyEmployerContribution": {
      "type": "number",
      "minimum": 0
    },
    "contributionVariation": {
      "type": "string",
      "minLength": 1
    },
    "permittedExpenses": {
      "type": "string",
      "minLength": 1
    },
    "claimsRunoutDays": {
      "type": "integer",
      "minimum": 0
    }
  }
}
